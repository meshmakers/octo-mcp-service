<Project Sdk="Microsoft.NET.Sdk">

    <!-- AB#8475: the content guard of knowledge (and later memory) writes. No OctoMesh dependencies on purpose: the
         memory writes of the agent runtime (AB#8473) take it over by moving this project into a shared package. The
         tenant secret values come in through ISecretFingerprintSource, implemented by the host. -->
    <PropertyGroup>
        <AssemblyName>Meshmakers.Octo.Backend.McpServices.ContentGuard</AssemblyName>
        <RootNamespace>Meshmakers.Octo.Backend.McpServices.ContentGuard</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    </ItemGroup>
</Project>
